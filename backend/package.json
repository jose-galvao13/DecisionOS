{
  "name": "decisionos-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Backend for DecisionOS: Postgres-backed multi-tenant foundation (auth, organizations/roles, data sources, unified data model) plus the server-side Claude advisor/tool-execution loop.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed:demo": "node src/db/seedDemoOrg.js",
    "worker": "node src/worker.js",
    "desktop:poc": "node scripts/poc-embedded-pg.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  }
}
