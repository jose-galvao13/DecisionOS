{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DecisionOS",
  "version": "0.1.0",
  "identifier": "app.decisionos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build:tauri --prefix ../frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DecisionOS",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:58732; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "publisher": "DecisionOS",
    "copyright": "© DecisionOS",
    "category": "Business",
    "shortDescription": "AI-native decision intelligence, installed locally.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/backend/**/*": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "PortugueseBR"]
      }
    }
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "binaries/node",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}
